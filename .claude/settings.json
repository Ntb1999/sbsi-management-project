{
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf /)",
      "Bash(pulumi destroy*)",
      "Bash(terraform destroy*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/worktree-guard.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/knowledge-base-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/command-guard.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/pre-commit-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/worktree-edit-guard.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/secrets-edit-guard.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/no-fallbacks-guard.sh"
          }
        ]
      }
    ]
  }
}
