# Cloudflare KV (accessed over the REST API — this app doesn't run on
# Cloudflare's Workers runtime, so a native binding isn't available).
# Use the SAME namespace ID that's bound to the original Cloudflare Pages
# Functions in production, so this app reads/writes the existing test-status
# data instead of starting from an empty namespace.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
# API token scoped to "Workers KV Storage: Edit" for that namespace
CLOUDFLARE_API_TOKEN=

# Jira FSS (projects.fss.com.vn) — Basic Auth credentials for the
# /api/jira-sync proxy. Previously hardcoded in source; now env-only.
JIRA_USER=
JIRA_PASS=
